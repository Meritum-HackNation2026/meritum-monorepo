# Meritum: zmienne dla `docker compose up` (skopiuj do .env i uzupełnij).
# Bez .env wszystko działa na stubach, a test gotowości (/api/v1/health)
# wypisuje brakujące zmienne. Nie commituj .env.

# --- Sól (lokalnie compose ma jawną wartość domyślną; poza komputerem wymagana) ---
# Sól do skrótów identyfikatorów użytkowników kanałów i liczników limitów.
# Dowolny losowy ciąg, np. wynik `openssl rand -hex 32`.
MERITUM_CHANNEL_HASH_SALT=

# --- Model językowy (ADR-14: region UE) ---
# stub: bez kluczy i sieci (odpowiedź z config/llm-stub.json); vertex: Vertex AI.
MERITUM_LLM_PROVIDER=stub
# Dla vertex: przypięta wersja modelu, region UE i projekt Google Cloud.
# Logowanie przez Application Default Credentials (konto serwisowe).
MERITUM_LLM_MODEL=
MERITUM_LLM_REGION=europe-central2
MERITUM_LLM_PROJECT=

# --- Bramki przed modelem ---
# Maskowanie danych osobowych: none (tylko wzorce) albo sdp (Google DLP, UE).
MERITUM_PII_GATE=none
MERITUM_PII_PROJECT=
MERITUM_PII_LOCATION=europe-central2
# Klasyfikator wstrzyknięć poleceń (pusta wartość: bramka wyłączona).
MERITUM_INJECTION_GATE_PROVIDER=
MERITUM_INJECTION_GATE_PROJECT=
MERITUM_INJECTION_GATE_ACCOUNT_ID=
MERITUM_INJECTION_GATE_API_TOKEN=

# --- Embeddingi i transkrypcja nagrań ---
# stub albo vertex / speech_v2 (Google Cloud, region UE).
MERITUM_EMBEDDINGS_PROVIDER=stub
MERITUM_EMBEDDINGS_PROJECT=
MERITUM_TRANSCRIPTION_PROVIDER=stub
MERITUM_TRANSCRIPTION_PROJECT=

# --- Discord (opcjonalnie) ---
# Klucz publiczny aplikacji Discord; bez niego endpoint interakcji nie istnieje.
MERITUM_DISCORD_PUBLIC_KEY=
# Token bota; wymagany, gdy ustawiony jest klucz publiczny.
MERITUM_DISCORD_BOT_TOKEN=
# Proces Gateway (wzmianki i wiadomości prywatne) startuje tylko z profilem discord
# i tokenem bota. Odkomentuj, by `docker compose up` włączało go samo:
# COMPOSE_PROFILES=discord

# --- Logowanie do panelu moderatora (opcjonalnie) ---
MERITUM_SESSION_SECRET=
MERITUM_GOOGLE_CLIENT_ID=
MERITUM_GOOGLE_CLIENT_SECRET=
MERITUM_MICROSOFT_CLIENT_ID=
MERITUM_MICROSOFT_CLIENT_SECRET=
# Adresy e-mail administratorów panelu, oddzielone przecinkami.
MERITUM_ADMIN_EMAILS=
